# =====================================================================
# Salin file ini menjadi .env.local untuk mencoba di komputer sendiri.
# Di Vercel: isi ketiganya di Settings -> Environment Variables.
# JANGAN pernah commit file .env.local ke GitHub.
# =====================================================================

# 1. Kunci penanda tangan sesi login (bebas, tapi harus panjang & rahasia).
#    Buat dengan perintah:
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=ganti-dengan-kunci-acak-panjang

# 2. Alamat Web App Apps Script (diakhiri /exec).
BRIDGE_URL=https://script.google.com/macros/s/AKfycbXXXXXXXXXXXXXXXXXXXX/exec

# 3. Token rahasia — HARUS sama persis dengan nilai TOKEN di apps-script/Code.gs
BRIDGE_TOKEN=ganti-dengan-token-rahasia
